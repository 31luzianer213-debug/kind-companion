# =====================================================================
# Sigma Control — modelo de variáveis de ambiente (copie para .env)
# NUNCA versione o .env real: ele contém chaves de produção.
# =====================================================================

# Supabase
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# URL pública do app — usada nos webhooks e nos links enviados ao cliente.
# Sem ela o sistema tenta usar o domínio da própria requisição.
PUBLIC_APP_URL="https://seudominio.com.br"

# E-mail do administrador do sistema. Sem ele (aqui ou no painel Admin)
# ninguém é administrador — não existe mais e-mail fixo no código.
ADMIN_EMAIL=""

# Token que protege o webhook do robô do WhatsApp.
# Sem ele o endpoint recusa todas as requisições (fail-closed).
WHATSAPP_WEBHOOK_TOKEN=""

# Evolution API (WhatsApp) — provedor alternativo
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""

# Segredo das rotinas automáticas (cobranças e conferência das assinaturas).
# Sem ele, os endpoints /api/public/hooks/cobranca-diaria e
# /api/public/hooks/saas-reconcile recusam todas as chamadas.
BILLING_CRON_SECRET=""

# Porta do servidor (padrão 3000)
PORT=3000
NODE_ENV=production
